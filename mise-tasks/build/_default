#!/usr/bin/env bash
#MISE description="Compile TypeScript to JavaScript"
set -euo pipefail

# The committed bundles are built from the installed dependency tree, and ncc
# derives its module ids from where those modules sit on disk. bun and pnpm lay
# the tree out differently from npm, so building under one of them emits bundles
# that differ from the runner's on actions the change never touched, and the
# Build check then rejects them. Refuse to build from a tree npm did not install.
for foreign_lock in bun.lock bun.lockb pnpm-lock.yaml yarn.lock; do
  if [ -e "${foreign_lock}" ]; then
    echo "refusing to build: ${foreign_lock} is present; this repo installs with npm only" >&2
    exit 1
  fi
done

# Recognise npm's own tree rather than listing the markers other managers leave.
# A deny-list only stops the managers it already knows: bun's hoisted linker
# writes real directories and no marker, and `bun install --no-save` leaves no
# lockfile either, so it walks past a list of known markers. npm writes this
# manifest on every install and no other manager does.
if [ -d node_modules ] && [ ! -e node_modules/.package-lock.json ]; then
  echo "refusing to build: node_modules was not installed by npm; run 'npm ci'" >&2
  exit 1
fi

while IFS= read -r action_file; do
  ./node_modules/.bin/ncc build "${action_file}" -o "$(dirname "${action_file}")/dist"
done < <(find actions -name 'action.ts' -not -path '*/tests/*' -not -path '*/dist/*')
